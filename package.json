{
  "name": "simplevtt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:presentation": "node scripts/generate-spell-presentation.mjs",
    "dev": "npm run generate:presentation && vite",
    "test:creation-structure:raw": "tsx --test tests/ui/characterCreationCompleteGate.test.ts tests/ui/characterSheetV10Structure.test.ts tests/ui/spellPresentationCatalog.test.ts tests/ui/spellUiStructure.test.ts tests/ui/combatSpellHudStructure.test.ts tests/ui/spellcastingRuntimeAdapter.test.ts",
    "test:creation-structure": "npm run generate:presentation && npm run test:creation-structure:raw",
    "test:rules-domain": "tsx --test tests/domain/phase04TargetingReaction.test.ts tests/domain/phase05Lifecycle.test.ts tests/domain/resolutionAtomic.test.ts tests/domain/spellcastingKernel.test.ts",
    "test:spellcasting": "npm run generate:presentation && tsx --test tests/domain/spellcastingKernel.test.ts tests/ui/combatSpellHudStructure.test.ts tests/ui/spellcastingRuntimeAdapter.test.ts",
    "build": "npm run generate:presentation && tsc --noEmit && npm run test:creation-structure:raw && npm run test:rules-domain && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.1.5"
  }
}
