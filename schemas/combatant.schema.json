{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplevtt.local/schemas/combatant.schema.json",
  "title": "SimpleVTT CombatantDefinition",
  "description": "Draft structural schema. Common rule mechanic/predicate/timing semantics are validated separately against the active Common Rule Specification and RulesProfile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "rulesProfile", "stats", "actions"],
  "properties": {
    "schemaVersion": { "const": "0.2-draft" },
    "id": { "$ref": "#/$defs/stableId" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "rulesProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "stats": { "$ref": "#/$defs/stats" },
    "abilities": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "saves": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "skills": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "defenses": { "$ref": "#/$defs/defenses" },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "reactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "activities": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "ruleSources": {
      "type": "array",
      "items": { "$ref": "#/$defs/ruleSource" }
    },
    "activationState": {
      "type": "object",
      "additionalProperties": {
        "type": ["boolean", "string", "number", "null"]
      }
    },
    "unsupportedMechanics": {
      "type": "array",
      "items": { "$ref": "#/$defs/unsupported" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "minLength": 1
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hp", "ac"],
      "properties": {
        "hp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max"],
          "properties": {
            "max": { "type": "number", "minimum": 0 },
            "tempDefault": { "type": "number", "minimum": 0, "default": 0 }
          }
        },
        "ac": { "type": "number" },
        "speed": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "initiative": { "type": "number" },
        "proficiency": { "type": "number" }
      }
    },
    "defenses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "damageResistances": { "$ref": "#/$defs/stringSet" },
        "damageImmunities": { "$ref": "#/$defs/stringSet" },
        "damageVulnerabilities": { "$ref": "#/$defs/stringSet" },
        "conditionImmunities": { "$ref": "#/$defs/stringSet" }
      }
    },
    "stringSet": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "max"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "max": { "type": "number", "minimum": 0 },
        "initial": { "type": "number", "minimum": 0 },
        "resetPolicy": { "type": "string" },
        "sourceId": { "$ref": "#/$defs/stableId" }
      }
    },
    "targeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["self", "single", "choose-n", "multiple-manual"]
        },
        "minTargets": { "type": "integer", "minimum": 0 },
        "maxTargets": { "type": "integer", "minimum": 0 },
        "filterTags": { "$ref": "#/$defs/stringSet" },
        "rollPolicy": {
          "type": "string",
          "enum": ["shared", "per-target", "profile-defined"]
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "economy": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resourceId", "amount"],
            "properties": {
              "resourceId": { "$ref": "#/$defs/stableId" },
              "amount": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "targeting", "mechanics"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "sourceId": { "$ref": "#/$defs/stableId" },
        "targeting": { "$ref": "#/$defs/targeting" },
        "cost": { "$ref": "#/$defs/cost" },
        "predicate": { "$ref": "#/$defs/declarativeNode" },
        "mechanics": {
          "type": "array",
          "items": { "$ref": "#/$defs/mechanic" },
          "minItems": 1
        }
      }
    },
    "ruleSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "mechanics"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "activationPredicate": { "$ref": "#/$defs/declarativeNode" },
        "mechanics": {
          "type": "array",
          "items": { "$ref": "#/$defs/mechanic" },
          "minItems": 1
        }
      }
    },
    "mechanic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": { "type": "string", "minLength": 1 },
        "target": { "type": "string" },
        "value": {},
        "expression": { "$ref": "#/$defs/declarativeNode" },
        "predicate": { "$ref": "#/$defs/declarativeNode" },
        "timing": { "type": "string" },
        "duration": { "$ref": "#/$defs/declarativeNode" },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "declarativeNode": {
      "type": ["object", "array", "string", "number", "boolean", "null"]
    },
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "reason"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "originalText": { "type": "string" }
      }
    }
  }
}
