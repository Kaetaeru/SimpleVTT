{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplevtt.local/schemas/installed-content.schema.json",
  "title": "SimpleVTT Installed Content v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "storageRevision", "entries"],
  "properties": {
    "schemaId": { "const": "simplevtt.installed-content" },
    "schemaVersion": { "const": 1 },
    "storageRevision": { "type": "integer", "minimum": 0 },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "moduleRef": {
      "type": "object", "additionalProperties": false,
      "required": ["moduleId", "version"],
      "properties": { "moduleId": {"type":"string","minLength":1}, "version": {"type":"string","minLength":1} }
    },
    "extensionPoint": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "acceptsCategories"],
      "properties": { "id": {"type":"string","minLength":1}, "acceptsCategories": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true} }
    },
    "moduleManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["moduleId", "moduleVersion", "rulesProfile", "dependencies", "conflicts", "capabilities", "extensionPoints"],
      "properties": {
        "moduleId": {"type":"string","minLength":1}, "moduleVersion": {"type":"string","minLength":1},
        "rulesProfile": {"type":"object","additionalProperties":false,"required":["id","version"],"properties":{"id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1}}},
        "dependencies": {"type":"array","items":{"$ref":"#/$defs/moduleRef"}},
        "conflicts": {"type":"array","items":{"$ref":"#/$defs/moduleRef"}},
        "capabilities": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
        "extensionPoints": {"type":"array","items":{"$ref":"#/$defs/extensionPoint"}}
      }
    },
    "semanticRelationship": {
      "type":"object", "additionalProperties":false,
      "required":["kind","target"],
      "properties": {
        "kind":{"enum":["parent","extends","replaces"]}, "target":{"type":"string","minLength":1},
        "targetVersion":{"type":"string","minLength":1}, "extensionPoint":{"type":"string","minLength":1}
      }
    },
    "mechanic": {
      "type":"object", "additionalProperties":false,
      "required":["kind","config"],
      "properties": {
        "id":{"type":"string","minLength":1},
        "kind":{"const":"common-play"},
        "config":{"$ref":"https://simplevtt.local/schemas/common-play-contract.schema.json"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentId", "category", "nameKo", "nameEn", "sourceId", "source", "version", "description", "relationships", "capabilities"],
      "properties": {
        "contentId": { "type": "string", "minLength": 1 },
        "category": { "enum": ["class", "subclass", "species", "background", "feat", "spell", "item", "condition", "combatant", "option"] },
        "nameKo": { "type": "string" }, "nameEn": { "type": "string" },
        "sourceId": { "type": "string", "minLength": 1 }, "source": { "type": "string" }, "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "relationships": { "type": "array", "items": { "type": "object", "required": ["label", "targetId", "targetName"], "properties": { "label": {"type":"string"}, "targetId": {"type":"string"}, "targetName": {"type":"string"} } } },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "requiresCapabilities": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
        "semanticRelationships": {"type":"array","items":{"$ref":"#/$defs/semanticRelationship"}},
        "extensionPoints": {"type":"array","items":{"$ref":"#/$defs/extensionPoint"}},
        "module": {"$ref":"#/$defs/moduleManifest"},
        "mechanics": {"type":"array","items":{"$ref":"#/$defs/mechanic"}}
      }
    }
  }
}
