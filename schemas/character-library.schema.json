{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplevtt.local/schemas/character-library.schema.json",
  "title": "SimpleVTT Character Library v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "storageRevision", "activeCharacterId", "characters"],
  "properties": {
    "schemaId": { "const": "simplevtt.character-library" },
    "schemaVersion": { "const": 1 },
    "storageRevision": { "type": "integer", "minimum": 0 },
    "activeCharacterId": { "type": ["string", "null"] },
    "characters": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characterId", "sourceRevision", "runtimeRevision", "source", "runtime", "materializedCache"],
      "properties": {
        "characterId": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "integer", "minimum": 1 },
        "runtimeRevision": { "type": "integer", "minimum": 1 },
        "source": { "$ref": "#/$defs/source" },
        "runtime": { "$ref": "#/$defs/runtime" },
        "materializedCache": { "$ref": "#/$defs/cache" }
      }
    },
    "source": {
      "type": "object",
      "required": ["characterId", "name", "rulesProfile", "build", "spellAndFeatureSelections", "progression", "itemReferences"],
      "properties": {
        "characterId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "rulesProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "build": { "type": "object" },
        "creationAuthoring": { "$ref": "#/$defs/creationAuthoring" },
        "spellAndFeatureSelections": { "type": "object" },
        "progression": { "type": "object" },
        "itemReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "definitionId", "provenance"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "definitionId": { "type": "string", "minLength": 1 },
              "provenance": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "creationAuthoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness", "rulesProfileId", "name", "className", "subclassName", "species", "background", "level",
        "abilityMethod", "abilities", "rolledPool", "rolledAssignments", "selectedSkills", "selectedSpells",
        "selectedClassChoices", "equipmentPreset", "backgroundEquipmentPreset", "choiceSelections", "notes", "overrides"
      ],
      "properties": {
        "completeness": { "const": "explicit" },
        "rulesProfileId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "className": { "type": "string" },
        "subclassName": { "type": "string" },
        "species": { "type": "string" },
        "background": { "type": "string" },
        "level": { "type": "integer", "minimum": 1 },
        "abilityMethod": { "enum": ["standard", "rolled", "point-buy", "custom"] },
        "abilities": { "type": "object" },
        "rolledPool": { "type": "array" },
        "rolledAssignments": { "type": "object" },
        "selectedSkills": { "type": "array", "items": { "type": "string" } },
        "selectedSpells": { "type": "array", "items": { "type": "string" } },
        "selectedClassChoices": { "type": "array", "items": { "type": "string" } },
        "equipmentPreset": { "type": "string" },
        "backgroundEquipmentPreset": { "type": "string" },
        "choiceSelections": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "notes": { "type": "string" },
        "overrides": { "type": "object" }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["hp", "tempHp", "resources", "items"],
      "properties": {
        "hp": { "type": "number" },
        "tempHp": { "type": "number" },
        "lifeFlags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stable", "unconscious", "dead"],
          "properties": {
            "stable": { "type": "boolean" },
            "unconscious": { "type": "boolean" },
            "dead": { "type": "boolean" }
          }
        },
        "resources": { "type": "array" },
        "items": { "type": "array" },
        "goldGp": { "type": "number" }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRevision", "runtimeRevision", "sheet"],
      "properties": {
        "sourceRevision": { "type": "integer", "minimum": 1 },
        "runtimeRevision": { "type": "integer", "minimum": 1 },
        "sheet": { "type": "object" }
      }
    }
  }
}
