    {
      "spellId": "dnd.srd521.spell.shield",
      "baseLevel": 1,
      "runtimeSupport": "combat-executable",
      "castingEconomy": "reaction",
      "targeting": { "kind": "creature", "rangeFeet": 0, "minTargets": 1, "maxTargets": 1, "allowedRelations": ["self"] },
      "primary": { "kind": "tracked-effect", "summary": "다음 자기 턴 시작까지 AC +5.", "duration": { "kind": "rounds", "amount": 1, "anchorActorId": "$source", "boundary": "start" } },
      "trackedEffects": [{ "summary": "AC +5", "trigger": "always", "duration": { "kind": "rounds", "amount": 1, "anchorActorId": "$source", "boundary": "start" }, "armorClass": { "bonus": 5 } }],
      "components": { "verbal": true, "somatic": true },
      "executionScope": "Authored (C1-03): a reaction that gives the caster +5 AC until the start of their next turn; attack rolls against the caster judge against the raised AC. Casting it against the triggering attack after that attack's roll, and the Magic Missile immunity, are left to the DM (재판정 with the post-hoc toggles)."
    },
