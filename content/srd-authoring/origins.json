       "status": "derived",
       "reason": "rangedWeaponAttackBonus is read into the ranged attack bonus by the derivation"
      }
     }
    },
    {
     "kind": "common-play",
     "config": {
      "$schema": "https://simplevtt.local/schemas/common-play-contract.schema.json",
      "schemaVersion": "0.2-draft",
      "id": "dnd.srd521.feat.fighting-style.archery",
      "interceptors": [
       {
        "id": "ranged-weapon-attack-bonus",
        "timing": "d20.outcome-determined",
        "operation": "recalculate",
        "slot": "d20.roll",
        "families": [
         "attack-roll"
        ],
        "factQueries": [
         {
          "id": "ranged",
          "fact": "attack.weapon.ranged",
          "subject": "intercepted.actor",
          "authority": "host",
          "visibility": "public",
          "unknownPolicy": "treat-false"
         }
        ],
        "when": {
         "op": "eq",
         "left": {
          "ref": "ranged"
         },
         "right": {
          "value": true
         }
        },
        "operations": [
         {
          "kind": "roll.modify",
          "mode": "add-flat",
          "value": {
           "value": 2
          }
         }
        ]
       }
      ]
     }
    }
   ],
