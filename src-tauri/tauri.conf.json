{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleVTT",
  "version": "0.1.0",
  "identifier": "dev.simplevtt.app",
  "build": {
    "beforeDevCommand": "npm run dev:client",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build:client",
    "frontendDist": "../dist-client"
  },
  "app": {
    "windows": [
      {
        "title": "SimpleVTT",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
